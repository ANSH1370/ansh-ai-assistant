# ── LLM (Groq — free tier, OpenAI-compatible API) ──────────────
GROQ_API_KEY=gsk_your_key_here
# generation model (quality) and fast model (guard/rewrite steps)
GEN_MODEL=llama-3.3-70b-versatile
FAST_MODEL=llama-3.1-8b-instant

# ── Vector store (Qdrant) ──────────────────────────────────────
# Leave QDRANT_URL empty to use a local on-disk store (./qdrant_local)
# — perfect for development, no cloud needed.
QDRANT_URL=
QDRANT_API_KEY=

# ── API behavior ───────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,https://anshmangukiya.vercel.app,https://anshmangukiya.com
RATE_LIMIT_PER_MIN=20
